---
import { Seo, type TitleMetaLinkTag } from '@datocms/astro/Seo';
import { Header } from '~/components/Header';
import { Footer } from '~/components/Footer';
import ContentLink from '~/components/ContentLink.astro';
import { DraftModeBadge } from '~/components/DraftModeBadge';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { isDraftModeEnabled } from '~/lib/draftMode';
import { ensureTitle } from '~/lib/datocms/seo';
import { LayoutQuery } from './_graphql';
import '../styles/global.css';

interface Props {
  pageSeo?: TitleMetaLinkTag[];
}

const { pageSeo } = Astro.props;
const draftMode = await isDraftModeEnabled(Astro.cookies);
const data = await executeQuery(Astro, LayoutQuery);
const seoData = ensureTitle()([
  ...(pageSeo || []),
  ...(data._site.favicon || []),
]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo data={seoData} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer data={data} />
    {
      draftMode && (
        <>
          <DraftModeBadge />
          <ContentLink />
        </>
      )
    }
    <DraftModeQueryListener query={LayoutQuery} />
  </body>
</html>
