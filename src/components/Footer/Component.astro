---
import { readFragment, type FragmentOf } from '~/lib/datocms/graphql';
import { isDraftModeEnabled } from '~/lib/draftMode';
import { FooterFragment } from './graphql';
import styles from './style.module.css';

interface Props {
  data: FragmentOf<typeof FooterFragment>;
}

const { data } = Astro.props;
const { contact, about } = readFragment(FooterFragment, data);
const instagramUrl =
  about?.instagramUrl || 'https://www.instagram.com/marcoverna.studio/';
const draftMode = await isDraftModeEnabled(Astro.cookies);
---

<footer class={styles.footer}>
  <span class={styles.left}>
    &copy; {new Date().getFullYear()} Marco Verna
  </span>
  <nav class={styles.social}>
    <a href={instagramUrl} target="_blank" rel="noopener noreferrer"
      >Instagram</a
    >
    {contact?.email && <a href={`mailto:${contact.email}`}>{contact.email}</a>}
    {
      /* When draft mode is on, the floating badge is the way out — no need
         for a second control down here. */
      !draftMode && (
        <a href="#" data-draft-toggle>
          Log in
        </a>
      )
    }
  </nav>
</footer>

<script>
  const toggle = document.querySelector('[data-draft-toggle]');
  toggle?.addEventListener('click', (e) => {
    e.preventDefault();
    const token = prompt(
      'Paste your preview token from DatoCMS to view unpublished changes on this site:',
    );
    if (token) {
      window.location.href = `/api/draft-mode/enable?token=${encodeURIComponent(token)}&redirect=${encodeURIComponent(window.location.pathname)}`;
    }
  });
</script>
