---
import { QueryListener } from '@datocms/astro/QueryListener';
import type { QueryListenerOptions } from '@datocms/astro/QueryListener';
import { convertToAutoPaginationQueryAndVariables } from '@datocms/cda-client';
import { DATOCMS_DRAFT_CONTENT_CDA_TOKEN, DATOCMS_BASE_EDITING_URL } from 'astro:env/server';
import { isDraftModeEnabled } from '~/lib/draftMode';

/*
 * This component utilizes the QueryListener component of @datocms/astro to enable automatic
 * page refresh whenever the result of the specified query changes. The described effect only
 * occurs when the draft mode is ON.
 */

type Props<QueryResult, QueryVariables> = Omit<
  QueryListenerOptions<QueryResult, QueryVariables>,
  'includeDrafts' | 'token' | 'excludeInvalid'
>;

const draftModeEnabled = await isDraftModeEnabled(Astro);

const { query: originalQuery, variables: originalVariables, ...rest } = Astro.props;

const [query, variables] = convertToAutoPaginationQueryAndVariables(
  originalQuery,
  originalVariables,
);
---

{draftModeEnabled && (
  <QueryListener
    {...rest}
    query={query}
    variables={variables}
    token={DATOCMS_DRAFT_CONTENT_CDA_TOKEN}
    excludeInvalid
    includeDrafts
    contentLink="v1"
    baseEditingUrl={DATOCMS_BASE_EDITING_URL}
  />
)}
