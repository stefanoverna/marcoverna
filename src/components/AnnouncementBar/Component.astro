---
import styles from './style.module.css';
---

<a
  href="https://colorscheme.marcoverna.studio/"
  class={styles.bar}
  target="_blank"
  rel="noopener noreferrer"
>
  <span class={styles.pill}>New</span>
  <span class={styles.brand}
    ><span class={styles.brandItalic}>Color Scheme</span>
    <span class={styles.brandBold}>Studio</span></span
  >
  <span class={styles.dot} aria-hidden="true"></span>
  <span class={`${styles.text} ${styles.textDesc}`}
    >— a free tool for studying color relationships</span
  >
  <span class={styles.arrow} aria-hidden="true">→</span>
</a>
