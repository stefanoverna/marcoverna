---
import { readFragment, type FragmentOf } from '~/lib/datocms/graphql';
import { VideoBlockFragment } from './graphql';
import styles from './style.module.css';

interface Props {
  block: FragmentOf<typeof VideoBlockFragment>;
}

const { block } = Astro.props;
const data = readFragment(VideoBlockFragment, block);
const { video, _editingUrl } = data;
---

<div class={styles.video} data-datocms-content-link-url={_editingUrl}>
  <iframe
    src={video.provider === 'youtube'
      ? `https://www.youtube.com/embed/${video.providerUid}`
      : `https://player.vimeo.com/video/${video.providerUid}`}
    width="100%"
    height="480"
    allow="autoplay; fullscreen; picture-in-picture"
    allowfullscreen
    style="border: 0"
  ></iframe>
</div>
