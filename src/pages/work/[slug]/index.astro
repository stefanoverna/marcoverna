---
import Layout from '~/layouts/Layout.astro';
import { StructuredText } from '@datocms/astro/StructuredText';
import { ResponsiveImage } from '~/components/ResponsiveImage';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { WorkDetailQuery } from './_graphql';
import styles from './_style.module.css';

const { slug } = Astro.params;
const { work, allWorks } = await executeQuery(Astro, WorkDetailQuery, { slug: slug! });
---

<Layout pageSeo={work?.seo}>
  {
    work && (
      <div class={styles.page}>
        <a href="/" class={styles.back}>← Back to work</a>

        <div class={styles.layout}>
          <div class={styles.info}>
            <h1 class={styles.title}>{work.title}</h1>
            {work.description && (
              <div class={styles.description} data-datocms-content-link-group>
                <StructuredText data={work.description} />
              </div>
            )}
          </div>
          {work.images && work.images.length > 0 && (
            <div class={styles.images}>
              {work.images.map((img) => (
                <ResponsiveImage data={img.responsiveImage} />
              ))}
            </div>
          )}
        </div>
      </div>
    )
  }

  <div class={styles.moreWorks}>
    <h2 class={styles.moreTitle}>More work</h2>
    <div class={styles.moreGrid}>
      {allWorks
        .filter((w) => w.slug !== slug)
        .map((work) => (
          <a href={`/work/${work.slug}`} class={styles.moreItem}>
            <ResponsiveImage data={work.coverImage.responsiveImage} />
            <p class={styles.moreItemTitle}>{work.title}</p>
          </a>
        ))}
    </div>
  </div>
</Layout>
