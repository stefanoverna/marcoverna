---
import Layout from '~/layouts/Layout.astro';
import { StructuredText } from '@datocms/astro/StructuredText';
import {
  ResponsiveImage,
  ResponsiveImageFragment,
} from '~/components/ResponsiveImage';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { seoPageTitle } from '~/lib/datocms/seo';
import { graphql } from '~/lib/datocms/graphql';
import { getInstagramFeed } from '~/lib/instagram';
import styles from './_style.module.css';

const query = graphql(
  `
    query {
      about {
        image {
          responsiveImage(imgixParams: { w: 800 }) {
            ...ResponsiveImageFragment
          }
        }
        bio {
          value
        }
        clients {
          responsiveImage(imgixParams: { w: 200 }) {
            ...ResponsiveImageFragment
          }
        }
        instagramUrl
      }
    }
  `,
  [ResponsiveImageFragment],
);

const { about } = await executeQuery(Astro, query, undefined, 'about-page');

const instagramPosts = await getInstagramFeed().catch(() => []);
---

<Layout pageSeo={seoPageTitle('About')([])}>
  <div class={styles.page}>
    <div class={styles.hero}>
      {
        about?.image?.responsiveImage && (
          <ResponsiveImage data={about.image.responsiveImage} />
        )
      }
      <div class={styles.heroText}>
        <h1 class={styles.title}>About</h1>
        {
          about?.bio && (
            <div class={styles.bio} data-datocms-content-link-group>
              <StructuredText data={about.bio} />
            </div>
          )
        }
      </div>
    </div>

    {
      about?.clients && about.clients.length > 0 && (
        <div class={styles.section}>
          <h2 class={styles.sectionHeading}>Clients</h2>
          <div class={styles.clients}>
            {about.clients.map((img) => (
              <div class={styles.clientLogo}>
                <ResponsiveImage data={img.responsiveImage} />
              </div>
            ))}
          </div>
        </div>
      )
    }

    {
      instagramPosts.length > 0 && (
        <div class={styles.section}>
          <h2 class={styles.sectionHeading}>
            <a
              href={
                about?.instagramUrl ||
                'https://www.instagram.com/marcoverna.studio/'
              }
            >
              Instagram
            </a>
          </h2>
          <div class={styles.instagramGrid}>
            {instagramPosts.map((post) => (
              <a
                href={post.permalink}
                target="_blank"
                rel="noopener noreferrer"
                class={styles.instagramItem}
              >
                <img src={post.proxiedUri} alt={post.caption} loading="lazy" />
              </a>
            ))}
          </div>
        </div>
      )
    }
  </div>
  <DraftModeQueryListener query={query} />
</Layout>
