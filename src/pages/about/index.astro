---
import Layout from '~/layouts/Layout.astro';
import { StructuredText } from '@datocms/astro/StructuredText';
import {
  ResponsiveImage,
  ResponsiveImageFragment,
} from '~/components/ResponsiveImage';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { seoPageTitle } from '~/lib/datocms/seo';
import { graphql } from '~/lib/datocms/graphql';
import styles from './_style.module.css';

const query = graphql(
  `
    query {
      about {
        image {
          responsiveImage(imgixParams: { w: 800 }) {
            ...ResponsiveImageFragment
          }
        }
        bio {
          value
        }
        clients {
          responsiveImage(imgixParams: { w: 200 }) {
            ...ResponsiveImageFragment
          }
        }
      }
    }
  `,
  [ResponsiveImageFragment],
);

const { about } = await executeQuery(query);

---

<Layout pageSeo={seoPageTitle('About')([])}>
  <div class={styles.page}>
    <div class={styles.hero}>
      {
        about?.image?.responsiveImage && (
          <ResponsiveImage data={about.image.responsiveImage} />
        )
      }
      <div class={styles.heroText}>
        <h1 class={styles.title}>About</h1>
        {
          about?.bio && (
            <div class={styles.bio}>
              <StructuredText data={about.bio} />
            </div>
          )
        }
      </div>
    </div>

    {
      about?.clients && about.clients.length > 0 && (
        <div class={styles.section}>
          <h2 class={styles.sectionHeading}>Clients</h2>
          <div class={styles.clients}>
            {about.clients.map((img) => (
              <div class={styles.clientLogo}>
                <ResponsiveImage data={img.responsiveImage} />
              </div>
            ))}
          </div>
        </div>
      )
    }
  </div>
</Layout>
