{
  "name": "marcoverna",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "rm -rf node_modules/.vite .astro && astro dev",
    "build": "astro build",
    "preview": "astro build && astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "deploy": "astro build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "generate-schema": "dotenv -c -- bash -c 'npx gql.tada generate schema https://graphql.datocms.com --header \"X-Exclude-Invalid: true\" --header \"Authorization: Bearer $DATOCMS_CDA_TOKEN\" && npx gql.tada generate-output'",
    "generate-cma-types": "dotenv -c -- datocms schema:generate ./src/lib/datocms/datocms-schema.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.2.0",
    "@datocms/astro": "^0.6.14",
    "@datocms/cda-client": "^0.2.10",
    "@datocms/rest-client-utils": "^5.4.9",
    "astro": "^7.2.0",
    "autosize": "^6.0.1",
    "gql.tada": "^1.11.3",
    "jose": "^6.2.8",
    "serialize-error": "^13.0.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@types/autosize": "^4.0.3",
    "@types/node": "^26.2.0",
    "datocms": "^4.0.29",
    "datocms-structured-text-dastdown": "^6.0.0",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "wrangler": "^4.120.0"
  }
}
